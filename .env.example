# Tavily search API key (https://app.tavily.com)
TAVILY_API_KEY=

# Database file path (relative to repo root). Defaults to ./uae-intel.sqlite
DATABASE_URL=./uae-intel.sqlite

# Web server port
PORT=3000

# Research politeness: min ms between outbound fetches
FETCH_DELAY_MS=800

# User agent for outbound fetches
FETCH_USER_AGENT=uae-intel-research/1.0 (+public business intelligence research)
